# Copy to rcms/deploy/dmp/.env.dmp on M80q002, fill in real values, never commit the filled copy.
# (This file, the .example, IS meant to be committed -- only the real .env.dmp is git-ignored.)

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

DMP_SECRET_KEY=

# Resolved per ADR-13 / rcms/docs/adr/ADR-005: single shared Postgres
# instance on M80q001. Create the `dmp` database/role there first --
# see rcms/docs/adr/ADR-005-single-shared-postgres-lab.md for the
# exact commands. Do not point this at a local M80q002 Postgres.
DMP_DATABASE_URL=postgres://dmp:REPLACE_ME@192.168.0.81:5432/dmp
