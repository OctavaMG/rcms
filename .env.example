# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env -- it's already in .gitignore.

DJANGO_SECRET_KEY=change-me-to-a-real-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,M80q001,192.168.0.81,rcms.octava.lab

# Set both when RCMS runs behind the Caddy reverse proxy, which
# terminates TLS. Origins must include the scheme.
DJANGO_TRUST_PROXY_TLS=True
DJANGO_CSRF_TRUSTED_ORIGINS=https://rcms.octava.lab

POSTGRES_DB=rcms
POSTGRES_USER=rcms
POSTGRES_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432
